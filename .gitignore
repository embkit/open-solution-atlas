# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node ---
# The kit's browser verifiers resolve Playwright from here; it is a tool
# install, not a dependency of the published site.
node_modules/
package.json
package-lock.json

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~

# --- Build / tooling outputs (intermediate, not deliverables) ---
/dist/
/build/
/tmp/
.cache/

# Any top-level underscore-prefixed directory is a build or scratch output:
# _site is the site build, _compat_site is what the compatibility job
# builds into, _shots* are Playwright screenshots taken while reviewing a
# design. Listing them individually would forget the next one, so the whole
# convention is ignored by prefix — the same rule discover_markdown() and
# check-links.py use to stay out of build output.
/_*/

# --- The ux-ui-agent-skills kit (local tool install, not repository content) ---
# 251 files of generic design doctrine. The project's actual standard is the
# vendored `docs/embkit-ui-contract.md`; the kit is the tooling the `redesign` /
# `design-review` / `a11y-audit` skills read from. One part of it IS committed:
# `design-systems/`, the interop protocol and the brand crosswalks this site
# maps its tokens against. Install the rest with:
#     npx ux-ui-skills add tokens taste workflows scripts accessibility rules \
#         components frameworks content agents
# Leave `templates` out: this repository already has one at that path.
/tokens/
/taste/
/components/
/frameworks/
/content/
/workflows/
/accessibility/
/scripts/
/.claude/

# --- Serena MCP (local symbol index, not repository content) ---
/.serena/

# --- Local env / secrets ---
.env
.env.*
*.local
